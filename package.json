{
  "name": "eidos",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "predev": "node scripts/gen-nav.mjs && node scripts/gen-migrated.mjs && node scripts/gen-examples.mjs && node scripts/gen-props.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/gen-nav.mjs && node scripts/gen-migrated.mjs && node scripts/gen-examples.mjs && node scripts/gen-props.mjs",
    "build": "next build",
    "start": "next start",
    "gen:nav": "node scripts/gen-nav.mjs",
    "verify": "node scripts/verify-render.mjs",
    "check:frames": "node scripts/check-frame-code.mjs",
    "check:nav": "node scripts/check-nav.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:visual": "node scripts/check-visual.mjs",
    "check:contract": "node scripts/check-contract.mjs",
    "forge:verify": "node scripts/forge-verify.mjs",
    "forge:health": "node scripts/forge-health.mjs",
    "gen:contract": "node scripts/forge-gen.mjs contract --sync",
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "gen:props": "node scripts/gen-props.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:plugin": "node scripts/build-plugin.mjs",
    "gen:migrated": "node scripts/gen-migrated.mjs",
    "gen:examples": "node scripts/gen-examples.mjs",
    "ui:build": "npm run build -w @eidos/ui",
    "ui:typecheck": "npm run typecheck -w @eidos/ui",
    "sb": "npm run storybook -w @eidos/storybook",
    "sb:build": "npm run build -w @eidos/storybook",
    "registry:build": "npm run build -w @eidos/registry",
    "cli:test": "node packages/cli/test/e2e.mjs",
    "cli:test:full": "node packages/cli/test/e2e-full.mjs",
    "mono:build": "turbo run build"
  },
  "dependencies": {
    "@eidos/ui": "*",
    "@ai-sdk/react": "^3.0.187",
    "@pierre/diffs": "^1.2.3",
    "@pierre/trees": "^1.0.0-beta.4",
    "@tailwindcss/postcss": "^4.3.0",
    "ai": "^6.0.185",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.17.0",
    "lucide-react": "^1.16.0",
    "mermaid": "^11.15.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "axe-core": "^4.11.4",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "turbo": "^2.9.16",
    "typescript": "^5",
    "ws": "^8.20.1"
  }
}
